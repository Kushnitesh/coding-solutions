#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n;
	    cin>>n;
	    int count_odd=0;
	    int count_even=0;
	    vector<int>v(n);
	    for(int i=0;i<n;i++)
	    {
	        cin>>v[i];
	    }
	    for(int i=0;i<n;i++)
	    {
	        if(v[i]%2==0)
	        {
	            count_even++;
	        }
	        else
	        {
	            count_odd++;
	        }
	    }
	    if(count_even==count_odd)
	    {
	        cout<<count_odd+count_even<<endl;
	    }
	    else
	    {
	        cout<<2*min(count_even,count_odd)+1<<endl;
	    }
	}

}
