#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	int n;
	cin>>n;
	vector<int>v(2*n);
    for(int i=0;i<2*n;i++)
    {
        cin>>v[i];
    }
    int sum=0;
    for(int i=0;i<n;i++)
    {
        for(int j=2*n-1;j>=n;j--)
        {
            if(v[i]>v[j])
            {
                sum +=v[i];
            }
            else
            {
                sum +=v[j];
            }
        }
    }
    cout<<sum<<endl;
	}
    
}
