#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n,k;
	    cin>>n>>k;
	    int count=0;
	    int long sum=0;
	    int maxi=0;
	    vector<int>v(n);
	    for(int i=0;i<n;i++)
	    {
	        cin>>v[i];
	    }
	    for(int i=0;i<n;i++)
	        {
	           sum +=v[i];
	           maxi=max(maxi,v[i]);
	           if(sum-maxi<=k)
	           {
	               count++;
	           }
	           else
	           {
	               break;
	           }
	        
	        
	    }
	    cout<<count<<endl;
	}

}
