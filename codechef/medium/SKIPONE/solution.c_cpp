#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n,k;
	    cin>>n>>k;
	    int count=0;
	    int sum=0;
	    vector<int>v(n);
	    for(int i=0;i<n;i++)
	    {
	        cin>>v[i];
	    }
	    
	    if(v[1]>k)
	    {
	        cout<<1<<endl;
	    }
	    else
	    {
	        for(int i=0;i<n;i++)
	        {
	            sum +=v[i];
	            while(sum>=k)
	            {
	                count++;
	                break;
	            }
	        }
	        cout<<count+1<<endl;
	    }
	}

}
